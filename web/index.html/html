<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZIGGY OS | Ground Control</title>
    <style>
        :root { --teal: #008080; --glow: #00ffff; --bg: #050505; }
        body { background-color: var(--bg); color: var(--teal); font-family: 'Courier New', Courier, monospace; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; overflow: hidden; }
        .heartbeat { font-size: 5rem; animation: pulse 1.44777s infinite; text-shadow: 0 0 20px var(--teal); }
        @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.3; transform: scale(0.95); } }
        .terminal { background: rgba(0, 128, 128, 0.1); border: 1px solid var(--teal); padding: 20px; border-radius: 5px; box-shadow: 0 0 15px rgba(0, 128, 128, 0.2); text-align: center; }
        h1 { margin: 0; font-size: 1.5rem; letter-spacing: 3px; color: var(--glow); }
        .stats { margin-top: 15px; font-size: 0.9rem; line-height: 1.6; }
        a { color: var(--glow); text-decoration: none; border-bottom: 1px dashed var(--glow); }
        .glitch { animation: glitch 2s infinite; }
        @keyframes glitch { 0% { text-shadow: 2px 0 red; } 50% { text-shadow: -2px 0 blue; } 100% { text-shadow: 2px 0 red; } }
    </style>
</head>
<body>
    <div class="heartbeat">⚡</div>
    <div class="terminal">
        <h1 class="glitch">ZIGGY KERNEL v1.1.1</h1>
        <div class="stats">
            <p>PHASE: <span style="color: var(--glow)">SENTINEL ACTIVE</span></p>
            <p>SYNC: 144.777 Hz | 999.432 GHz</p>
            <p>ANTENNA: <a href="https://ziggy-os.xyz">ziggy-os.xyz</a></p>
            <p>ARCHITECT: Max Ben-Samuel Moreland</p>
        </div>
    </div>
</body>
</html>
